cabal-version:      2.4
name:               sudoku
version:            0.1.0.0
synopsis:           Sudoku em Haskell - Trabalho Pratico de Programacao Funcional
build-type:         Simple
extra-source-files: README.md
                    data/*.txt

common comum
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:    base >=4.14 && <5

library
    import:           comum
    hs-source-dirs:   src
    exposed-modules:  Model
                      Board
                      Parsing

executable sudoku
    import:           comum
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    sudoku

test-suite sudoku-test
    import:           comum
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    sudoku
